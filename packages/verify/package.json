{
  "name": "@fracta/verify",
  "version": "0.1.2",
  "description": "Runtime verification tier (headless browser) for Fracta findings",
  "license": "MIT",
  "author": "Anderson Gadelha",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external playwright --external playwright-core",
    "dev": "tsup src/index.ts --format esm --dts --watch --external playwright --external playwright-core",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fracta/core": "workspace:*"
  },
  "optionalDependencies": {
    "playwright-core": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "playwright": "^1.48.0",
    "playwright-core": "^1.48.0",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
