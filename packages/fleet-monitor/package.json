{
  "name": "@fracta/fleet-monitor",
  "version": "0.1.0",
  "description": "Monitoramento passivo contínuo da frota — re-scan + alerta de regressão de nota",
  "license": "MIT",
  "author": "Anderson Gadelha",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "fracta-fleet-monitor": "dist/cli.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts",
    "dev": "tsup src/index.ts src/cli.ts --format esm --dts --watch",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fracta/web-scan": "workspace:*"
  },
  "devDependencies": {
    "tsup": "*",
    "typescript": "*",
    "vitest": "*",
    "@types/node": "*"
  }
}
